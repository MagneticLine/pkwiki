PKWIKI_MODEL_PROVIDER=your-provider
PKWIKI_MODEL_BASE_URL=https://api.example.com/v1
PKWIKI_MODEL_API=openai-completions
PKWIKI_MODEL_API_KEY=replace-with-local-secret
PKWIKI_MODEL_NAME=gpt-5.6-luna
PKWIKI_MODEL_REASONING_EFFORT=max

# GPT-5.6 Luna 可省略以下两项，pkwiki 会使用 Pi 0.82.1 的官方目录值。
PKWIKI_MODEL_CONTEXT_WINDOW=272000
PKWIKI_MODEL_MAX_TOKENS=128000
